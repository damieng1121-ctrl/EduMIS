# Copy this file to .env.local (for `next dev`) and .env (for `prisma` CLI commands).
# Never commit real secrets — .env* files are gitignored.

# --- Database -----------------------------------------------------------
# EduMIS's Postgres runs on host port 5434 in this environment, to avoid
# colliding with sibling apps' own local databases (Novadesk Helpdesk/
# SchoolCMS typically default to 5432/5433). Local dev:
# `docker run --name edumis-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=edumis -p 5434:5432 -d postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/edumis"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# EduMIS runs on port 3002 in this environment (3000 is Novadesk Helpdesk, 3001 is SchoolCMS).
NEXTAUTH_URL="http://localhost:3002"

# --- Google Identity Platform / Google Workspace SSO ---------------------
# Create OAuth 2.0 credentials in the GCP Console (APIs & Services > Credentials)
# for a project with Google Identity Platform enabled. Authorised redirect URI:
# http://localhost:3002/api/auth/callback/google (add your production URL too).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft Entra ID / Microsoft 365 SSO -------------------------------
# Register an app in the Azure Portal (Microsoft Entra ID > App registrations
# > New registration), "Accounts in any organizational directory" (work/school
# accounts only — matches the Google setup above, no personal Microsoft
# accounts). Add a client secret under Certificates & secrets. Redirect URI:
# http://localhost:3002/api/auth/callback/microsoft-entra-id (add your production URL too).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- 2FA -------------------------------------------------------------------
# Used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# --- Multi-tenancy ---------------------------------------------------------
# Root domain used to derive tenant subdomains, e.g. willowbrook.edumis.app
NEXT_PUBLIC_ROOT_DOMAIN="edumis.app"

# --- File storage ------------------------------------------------------------
# Local-disk storage for tenant logo uploads (see src/lib/storage.ts). Fine for
# dev/single-instance use; swap for Cloud Storage before deploying to Cloud Run
# with more than one instance (uploads wouldn't survive a redeploy either).
UPLOAD_STORAGE_DIR="./storage/uploads"

# --- Platform administration -------------------------------------------------
# Comma-separated emails allowed to sign in as a cross-tenant SUPER_ADMIN,
# regardless of Workspace domain (e.g. EduMIS's own staff).
EDUMIS_SUPER_ADMIN_EMAILS=""

# --- Email notifications ------------------------------------------------------
# Platform-wide SMTP relay (not per-tenant — schools don't bring their own mail
# server). Leave SMTP_HOST unset and notifications just log to the console in
# dev, or are silently disabled in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EduMIS <no-reply@edumis.app>"
